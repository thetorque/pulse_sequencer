# ad9912_rb3.lpf -- pins for the 3-WIRE AD9912 readback diagnostic.
# SDIO (D16) is bidirectional (read data comes back on it); SDO (C15) is NOT used.

LOCATE COMP "dds_sclk" SITE "E15";
LOCATE COMP "dds_sdio" SITE "D16";
LOCATE COMP "dds_csb" SITE "C16";
LOCATE COMP "dds_ioupdate" SITE "B15";
LOCATE COMP "dds_reset" SITE "B16";
LOCATE COMP "dds_pwrdwn" SITE "C14";
IOBUF PORT "dds_sclk" IO_TYPE=LVCMOS33;
IOBUF PORT "dds_sdio" IO_TYPE=LVCMOS33;
IOBUF PORT "dds_csb" IO_TYPE=LVCMOS33;
IOBUF PORT "dds_ioupdate" IO_TYPE=LVCMOS33;
IOBUF PORT "dds_reset" IO_TYPE=LVCMOS33;
IOBUF PORT "dds_pwrdwn" IO_TYPE=LVCMOS33;

LOCATE COMP "led_g1" SITE "L16";
LOCATE COMP "led_r1" SITE "K15";
LOCATE COMP "led_g2" SITE "K16";
LOCATE COMP "led_r2" SITE "J15";
LOCATE COMP "led_g3" SITE "J16";
LOCATE COMP "led_r3" SITE "H15";
LOCATE COMP "led_g4" SITE "M16";
LOCATE COMP "led_r4" SITE "L15";
LOCATE COMP "led_g5" SITE "N16";
LOCATE COMP "led_r5" SITE "M15";
LOCATE COMP "led_g6" SITE "G15";
LOCATE COMP "led_r6" SITE "G16";
IOBUF PORT "led_g1" IO_TYPE=LVCMOS33;
IOBUF PORT "led_r1" IO_TYPE=LVCMOS33;
IOBUF PORT "led_g2" IO_TYPE=LVCMOS33;
IOBUF PORT "led_r2" IO_TYPE=LVCMOS33;
IOBUF PORT "led_g3" IO_TYPE=LVCMOS33;
IOBUF PORT "led_r3" IO_TYPE=LVCMOS33;
IOBUF PORT "led_g4" IO_TYPE=LVCMOS33;
IOBUF PORT "led_r4" IO_TYPE=LVCMOS33;
IOBUF PORT "led_g5" IO_TYPE=LVCMOS33;
IOBUF PORT "led_r5" IO_TYPE=LVCMOS33;
IOBUF PORT "led_g6" IO_TYPE=LVCMOS33;
IOBUF PORT "led_r6" IO_TYPE=LVCMOS33;
